# 构建产物
/bin/
/dist/

# 本机真实清单。它包含仓库地址和路径，属于每台机器的私有配置，
# 不应该进版本库；examples/ark.yaml 才是模板。
/ark.yaml
ark.local.yaml

# 密钥文件。任何情况下都不应该出现在版本库里。
*.pass
*.key
.env
.env.*
!.env.example

# 前端
node_modules/
/web/dist/
.vite/

# 内嵌前端产物。构建结果每次都不同，提交它们只会制造 diff 噪音；
# 但 dist/ 目录必须存在且非空，否则没跑过前端构建的环境里
# `go:embed dist` 会让 go build 直接失败——因此保留 PLACEHOLDER。
/internal/hub/webui/dist/*
!/internal/hub/webui/dist/PLACEHOLDER

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
